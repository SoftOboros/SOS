{
  "name": "higher-prio-preempts-on-sem-give",
  "description": "A high-priority task takes a semaphore (count=0) and blocks; a low-priority task gives the sem and the high-priority task immediately becomes RUNNING. Verifies that sem.give wakes the highest-priority waiter and triggers preemption via sched.run.",
  "category": "smoke",
  "origin": "seed",
  "tags": [
    "scheduler",
    "sem",
    "preemption"
  ],
  "config": {
    "max_tasks": 8,
    "max_prio": 8,
    "max_sems": 8,
    "max_queues": 4,
    "q_depth": 16,
    "tick_hz": 1000
  },
