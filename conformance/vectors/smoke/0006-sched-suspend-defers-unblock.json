{
  "name": "sched-suspend-defers-unblock",
  "description": "A delayed task's deadline expires while the scheduler is suspended; the unblock is deferred until sched.resume drains pend_ticks. Verifies that sched_lock gates rescheduling separately from irq_nest and that resume correctly catches up.",
  "category": "smoke",
  "origin": "seed",
  "tags": [
    "sched-suspend",
    "delay",
    "pend-ticks"
  ],
