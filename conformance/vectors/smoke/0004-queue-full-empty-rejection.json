{
  "name": "queue-full-empty-rejection",
  "description": "Create a queue with cap=2; fill it with two non-blocking sends; the third send with timeout=0 returns RC_FULL. Symmetric pattern: drain the queue with two receives, then a third receive with timeout=0 returns RC_EMPTY.",
  "category": "smoke",
  "origin": "seed",
  "tags": [
    "queue",
    "rc-full",
    "rc-empty"
  ],
