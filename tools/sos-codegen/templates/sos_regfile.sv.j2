module sos_regfile_{{ view.peripheral_name }} #(
    parameter BUS_TYPE = "{{ view.bus_type }}",  // "axi4lite" (default) or "apb"
    parameter ADDR_W   = 32,
    parameter DATA_W   = 32
) (
    input  wire                clk,
    input  wire                rst,        // sync active-high (INV-S-HDL-A-1)

    // -----------------------------------------------------------------------
    // Bus slave port (per PCDN-SOS-09-E-001(a) AXI4-Lite default; APB alt).
    // Per PCDN-SOS-09-E-005(a) a single parameterised template exposes BOTH
    // port surfaces; only the surface matching BUS_TYPE is electrically active.
    // -----------------------------------------------------------------------
    // AXI4-Lite slave
    input  wire [ADDR_W-1:0]   s_axi_awaddr,
    input  wire                s_axi_awvalid,
    output wire                s_axi_awready,
    input  wire [DATA_W-1:0]   s_axi_wdata,
    input  wire [DATA_W/8-1:0] s_axi_wstrb,
    input  wire                s_axi_wvalid,
    output wire                s_axi_wready,
    output wire [1:0]          s_axi_bresp,
    output wire                s_axi_bvalid,
    input  wire                s_axi_bready,
    input  wire [ADDR_W-1:0]   s_axi_araddr,
    input  wire                s_axi_arvalid,
    output wire                s_axi_arready,
    output wire [DATA_W-1:0]   s_axi_rdata,
    output wire [1:0]          s_axi_rresp,
    output wire                s_axi_rvalid,
    input  wire                s_axi_rready,
    input  wire [2:0]          s_axi_awprot, // AxPROT[0] = privilege bit
    input  wire [2:0]          s_axi_arprot,

    // APB slave (active when BUS_TYPE == "apb")
    input  wire                psel,
    input  wire                penable,
    input  wire                pwrite,
    input  wire [ADDR_W-1:0]   paddr,
    input  wire [DATA_W-1:0]   pwdata,
    output wire [DATA_W-1:0]   prdata,
    output wire                pready,
    output wire                pslverr,
    input  wire [2:0]          pprot,        // PPROT[0] = privilege bit

    // -----------------------------------------------------------------------
    // Per-channel HW-side I/O (one set per chart channel, in doc order).
    // -----------------------------------------------------------------------
{% for ch in view.channels %}
    // Channel {{ ch.index }}: name={{ ch.name }}, kind={{ ch.kind }}, dir={{ ch.dir }}, zone={{ ch.zone }}, region={{ ch.privilege_region }}
{% if ch.kind == 'status' %}
    input  wire [{{ ch.width_w - 1 }}:0] hw_{{ ch.name }}_value,
    input  wire                hw_{{ ch.name }}_strobe,
{% elif ch.kind == 'command' %}
    output wire [{{ ch.width_w - 1 }}:0] hw_{{ ch.name }}_value,
    output wire                hw_{{ ch.name }}_fire,         // PCDN-SOS-09-E-006(b): registered
{% elif ch.kind == 'queue' %}
    // queue ports — sos_message_channel HW-side push/pop:
    output wire [{{ ch.width_w - 1 }}:0] hw_{{ ch.name }}_m_tdata,
    output wire                hw_{{ ch.name }}_m_tvalid,
    input  wire                hw_{{ ch.name }}_m_tready,
    input  wire [{{ ch.width_w - 1 }}:0] hw_{{ ch.name }}_s_tdata,
    input  wire                hw_{{ ch.name }}_s_tvalid,
    output wire                hw_{{ ch.name }}_s_tready,
    output wire                hw_{{ ch.name }}_empty,
    output wire                hw_{{ ch.name }}_full,
{% elif ch.kind == 'shared' %}
    // shared ports — sos_dpram_arb.port_a (HW side) + sos_mutex claim/grant:
    input  wire                hw_{{ ch.name }}_req,
    output wire                hw_{{ ch.name }}_grant,
    input  wire [ADDR_W-1:0]   hw_{{ ch.name }}_addr,
    input  wire [{{ ch.width_w - 1 }}:0] hw_{{ ch.name }}_wdata,
    input  wire                hw_{{ ch.name }}_we,
    input  wire                hw_{{ ch.name }}_re,
    output wire [{{ ch.width_w - 1 }}:0] hw_{{ ch.name }}_rdata,
{% endif %}
{% endfor %}

    // -----------------------------------------------------------------------
    // Access-violation aggregate output(s) — one per privilege_region.
    // PCDN-SOS-09-E-003(a) / §5.5.
    // -----------------------------------------------------------------------
{% for region in view.privilege_regions %}
    output wire access_violation_{{ region.name }}{% if not loop.last %},{% endif %}

{% endfor %}
);

    // -------------------------------------------------------------------
    // Register byte-offset constants — INV-S-MEM-E-6 (byte-for-byte
    // identical to SOS-09-B SVD <addressOffset>).
    // -------------------------------------------------------------------
{% for ch in view.channels %}
    localparam [ADDR_W-1:0] {{ ch.reg_offset_const }} = {{ ch.offset_bytes }};
{% endfor %}

    // -------------------------------------------------------------------
    // Per-register write/read masks (§5.3 — synthesized from chart
    // sos:bit_layout / kind-default).
    // -------------------------------------------------------------------
{% for ch in view.channels %}
    localparam [DATA_W-1:0] WRITE_MASK_{{ ch.name|upper }} = {{ ch.write_mask|hex32 }};
    localparam [DATA_W-1:0] READ_MASK_{{ ch.name|upper }}  = {{ ch.read_mask|hex32 }};
    localparam [DATA_W-1:0] RESET_VALUE_{{ ch.name|upper }} = {{ ch.reset_value|hex32 }};
{% endfor %}

    // -------------------------------------------------------------------
    // Bus decode — common surface produces (addr, wdata, valid_write,
    // valid_read, privilege_bit). BUS_TYPE selects which port set drives
    // these signals.
    // -------------------------------------------------------------------
    wire [ADDR_W-1:0]  bus_addr;
    wire [DATA_W-1:0]  bus_wdata;
    wire               bus_write_valid;
    wire               bus_read_valid;
    wire               bus_privilege; // 1 = privileged per AXI/APB convention inversion handled below

    // AXI4-Lite handshake collapse (write-address+write-data combined; v1
    // assumes back-to-back-ready handshake on the slave side).
    wire axi_write_fire = s_axi_awvalid & s_axi_wvalid;
    wire axi_read_fire  = s_axi_arvalid;

    // PPROT[0] / AxPROT[0]: 0 = privileged; we invert to a "privileged" boolean.
    wire axi_priv = ~s_axi_awprot[0];
    wire apb_priv = ~pprot[0];

    assign bus_addr        = (BUS_TYPE == "apb") ? paddr     : s_axi_awaddr;
    assign bus_wdata       = (BUS_TYPE == "apb") ? pwdata    : s_axi_wdata;
    assign bus_write_valid = (BUS_TYPE == "apb")
                              ? (psel & penable & pwrite)
                              : axi_write_fire;
    assign bus_read_valid  = (BUS_TYPE == "apb")
                              ? (psel & penable & ~pwrite)
                              : axi_read_fire;
    assign bus_privilege   = (BUS_TYPE == "apb") ? apb_priv : axi_priv;

    // Tie off the unused-bus handshake outputs to a benign value; the
    // BUS_TYPE consumer enforces which surface is real.
    assign s_axi_awready = (BUS_TYPE == "axi4lite") ? 1'b1 : 1'b0;
    assign s_axi_wready  = (BUS_TYPE == "axi4lite") ? 1'b1 : 1'b0;
    assign s_axi_arready = (BUS_TYPE == "axi4lite") ? 1'b1 : 1'b0;
    assign s_axi_bvalid  = 1'b0;
    assign s_axi_bresp   = 2'b00;
    assign pready        = (BUS_TYPE == "apb") ? 1'b1 : 1'b0;
    assign pslverr       = 1'b0;

    // -------------------------------------------------------------------
    // Per-channel register-decode lines (§5.2 — combinational).
    //   decode_<name>_write = bus_write_valid && (addr == OFFSET)
    //                        && zone_match && access_type_match
    //   decode_<name>_read  = analogous for read
    // Per INV-S-MEM-E-3 the clear-on-read strobe is gated on the
    // zone match AND the read enable — see the per-register flop bank
    // below.
    // -------------------------------------------------------------------
{% for ch in view.channels %}
    wire zone_match_{{ ch.name }} =
        ({{ "1'b1" if ch.zone == 'unprivileged' else "bus_privilege" }});
    wire access_type_write_ok_{{ ch.name }} =
        ({{ "1'b1" if ch.kind in ('command', 'queue', 'shared') else "1'b0" }});
    wire access_type_read_ok_{{ ch.name }} =
        ({{ "1'b1" if ch.kind in ('status', 'queue', 'shared') else "1'b0" }});

    wire addr_match_{{ ch.name }} =
        (bus_addr == {{ ch.reg_offset_const }});

    wire decode_{{ ch.name }}_write =
        bus_write_valid & addr_match_{{ ch.name }}
        & zone_match_{{ ch.name }} & access_type_write_ok_{{ ch.name }};
    wire decode_{{ ch.name }}_read =
        bus_read_valid  & addr_match_{{ ch.name }}
        & zone_match_{{ ch.name }} & access_type_read_ok_{{ ch.name }};

    // Access-violation strobe per §5.5: address matches but zone/type doesn't.
    wire access_violation_{{ ch.name }} =
        (bus_write_valid | bus_read_valid)
        & addr_match_{{ ch.name }}
        & ( (~zone_match_{{ ch.name }})
          | (bus_write_valid & ~access_type_write_ok_{{ ch.name }})
          | (bus_read_valid  & ~access_type_read_ok_{{ ch.name }}) );
{% endfor %}

    // -------------------------------------------------------------------
    // Per-channel realisation submodules (§5.2 table).
    // -------------------------------------------------------------------
{% for ch in view.channels %}
{% if ch.kind == 'status' %}
    // status / hw→sw : sos_strobe_latch + level-held value register.
    wire latched_{{ ch.name }};
    wire pending_q_{{ ch.name }};
    wire latched_state_q_{{ ch.name }};
    sos_strobe_latch u_status_{{ ch.name }} (
        .clk(clk),
        .rst(rst),
        .strobe(hw_{{ ch.name }}_strobe),
        .ack({% if ch.has_clear_on_read %}decode_{{ ch.name }}_read{% else %}1'b0{% endif %}),
        .latched(latched_{{ ch.name }}),
        .pending_q(pending_q_{{ ch.name }}),
        .latched_state_q(latched_state_q_{{ ch.name }})
    );
    reg [{{ ch.width_w - 1 }}:0] {{ ch.name }}_q;
    always @(posedge clk) begin
        if (rst) {{ ch.name }}_q <= RESET_VALUE_{{ ch.name|upper }};
        else if (hw_{{ ch.name }}_strobe) {{ ch.name }}_q <= hw_{{ ch.name }}_value;
        else if (decode_{{ ch.name }}_read & {{ "1'b1" if ch.has_clear_on_read else "1'b0" }})
            {{ ch.name }}_q <= {{ ch.width_w }}'d0;
    end
    wire [DATA_W-1:0] rd_{{ ch.name }} = {{ ch.name }}_q & READ_MASK_{{ ch.name|upper }};
{% elif ch.kind == 'command' %}
    // command / sw→hw : write-only holding register + REGISTERED fire strobe
    // (PCDN-SOS-09-E-006(b)). Optional sos_synchronizer on cross-domain `fire`.
    reg [{{ ch.width_w - 1 }}:0] {{ ch.name }}_holding_q;
    reg                          {{ ch.name }}_fire_reg;
    always @(posedge clk) begin
        if (rst) begin
            {{ ch.name }}_holding_q <= RESET_VALUE_{{ ch.name|upper }};
            {{ ch.name }}_fire_reg  <= 1'b0;
        end else if (decode_{{ ch.name }}_write) begin
            {{ ch.name }}_holding_q <=
                (bus_wdata & WRITE_MASK_{{ ch.name|upper }})
              | ({{ ch.name }}_holding_q & ~WRITE_MASK_{{ ch.name|upper }});
            {{ ch.name }}_fire_reg  <= 1'b1;
        end else begin
            {{ ch.name }}_fire_reg  <= 1'b0;
        end
    end
    assign hw_{{ ch.name }}_value = {{ ch.name }}_holding_q;
{% if ch.cross_domain %}
    // Cross-clock-domain channel (PCDN-SOS-09-E-004(a)): sos_synchronizer
    // on the fire strobe; SOS-08-A §6.9 contract.
    sos_synchronizer #(.WIDTH(1), .STAGES(2)) u_sync_{{ ch.name }}_fire (
        .clk_dst(clk),       // NB: HW-side clock should drive this; placeholder.
        .rst_dst(rst),
        .d_src({{ ch.name }}_fire_reg),
        .d_dst(hw_{{ ch.name }}_fire)
    );
{% else %}
    assign hw_{{ ch.name }}_fire = {{ ch.name }}_fire_reg;
{% endif %}
    wire [DATA_W-1:0] rd_{{ ch.name }} = {{ ch.width_w }}'d0; // command is WO
{% elif ch.kind == 'queue' %}
    // queue : sos_message_channel composing sos_dpram_arb (per SOS-08-B).
    sos_message_channel #(.TDATA_WIDTH({{ ch.width_w }})) u_queue_{{ ch.name }} (
        .clk(clk),
        .rst(rst),
        .s_axis_tdata(bus_wdata[{{ ch.width_w - 1 }}:0]),
        .s_axis_tevent_id({{ "16'd0" }}),
        .s_axis_tpayload({{ "32'd0" }}),
        .s_axis_tvalid(decode_{{ ch.name }}_write),
        .s_axis_tready(/* unused */),
        .m_axis_tdata(hw_{{ ch.name }}_m_tdata),
        .m_axis_tevent_id(),
        .m_axis_tpayload(),
        .m_axis_tvalid(hw_{{ ch.name }}_m_tvalid),
        .m_axis_tready(hw_{{ ch.name }}_m_tready),
        .full(hw_{{ ch.name }}_full),
        .empty(hw_{{ ch.name }}_empty),
        .count()
    );
    assign hw_{{ ch.name }}_s_tready = 1'b1;
    wire [DATA_W-1:0] rd_{{ ch.name }} = {{ "{{30{1'b0}}," }} hw_{{ ch.name }}_full, hw_{{ ch.name }}_empty};
{% elif ch.kind == 'shared' %}
    // shared : sos_dpram_arb + sos_mutex (per §5.2 / SOS-08-A).
    wire hw_grant_internal_{{ ch.name }};
    wire bus_grant_internal_{{ ch.name }};
    wire [{{ ch.width_w - 1 }}:0] rd_{{ ch.name }}_raw;
    sos_mutex #(.N_CLIENTS(2)) u_mutex_{{ ch.name }} (
        .clk(clk),
        .rst(rst),
        .req({hw_{{ ch.name }}_req, decode_{{ ch.name }}_write}),
        .ack({hw_grant_internal_{{ ch.name }}, bus_grant_internal_{{ ch.name }}}),
        .locked(),
        .holder_id()
    );
    assign hw_{{ ch.name }}_grant = hw_grant_internal_{{ ch.name }};
    sos_dpram_arb #(.ADDR_W(ADDR_W), .WIDTH({{ ch.width_w }})) u_dpram_{{ ch.name }} (
        .clk(clk),
        .rst(rst),
        .clk_a(clk), .rst_a(rst),
        .clk_b(clk), .rst_b(rst),
        .port_a_addr(hw_{{ ch.name }}_addr),
        .port_a_wdata(hw_{{ ch.name }}_wdata),
        .port_a_we(hw_{{ ch.name }}_we),
        .port_a_re(hw_{{ ch.name }}_re),
        .port_a_rdata(hw_{{ ch.name }}_rdata),
        .port_a_full(),
        .port_a_ready(),
        .port_b_addr(bus_addr[ADDR_W-1:0]),
        .port_b_wdata(bus_wdata[{{ ch.width_w - 1 }}:0]),
        .port_b_we(decode_{{ ch.name }}_write & bus_grant_internal_{{ ch.name }}),
        .port_b_re(decode_{{ ch.name }}_read  & bus_grant_internal_{{ ch.name }}),
        .port_b_rdata(rd_{{ ch.name }}_raw),
        .port_b_full(),
        .port_b_ready()
    );
{% if ch.width_w < 32 %}
    wire [DATA_W-1:0] rd_{{ ch.name }} = { { {{ 32 - ch.width_w }}{1'b0} }, rd_{{ ch.name }}_raw } & READ_MASK_{{ ch.name|upper }};
{% else %}
    wire [DATA_W-1:0] rd_{{ ch.name }} = rd_{{ ch.name }}_raw & READ_MASK_{{ ch.name|upper }};
{% endif %}
{% endif %}

{% endfor %}

    // -------------------------------------------------------------------
    // Read-data mux (default 0 — reserved-bit / non-matching-decode reads
    // return zero per PCDN-SOS-09-E-002(a)).
    // -------------------------------------------------------------------
    reg [DATA_W-1:0] read_data_mux;
    always @(*) begin
        read_data_mux = {DATA_W{1'b0}};
{% for ch in view.channels %}
        if (decode_{{ ch.name }}_read) read_data_mux = rd_{{ ch.name }};
{% endfor %}
    end
    assign s_axi_rdata = read_data_mux;
    assign s_axi_rresp = 2'b00;
    assign s_axi_rvalid = bus_read_valid;
    assign prdata = read_data_mux;

    // -------------------------------------------------------------------
    // Access-violation aggregation per privilege_region
    // (PCDN-SOS-09-E-003(a) — ONE sos_strobe_latch per region).
    // -------------------------------------------------------------------
{% for region in view.privilege_regions %}
    wire violation_or_{{ region.name }} = 1'b0
{% for member in region.member_channel_names %}
        | access_violation_{{ member }}
{% endfor %}
        ;
    wire violation_latched_{{ region.name }};
    wire violation_pending_q_{{ region.name }};
    wire violation_latched_state_q_{{ region.name }};
    sos_strobe_latch {{ region.latch_inst }} (
        .clk(clk),
        .rst(rst),
        .strobe(violation_or_{{ region.name }}),
        .ack(1'b0),
        .latched(violation_latched_{{ region.name }}),
        .pending_q(violation_pending_q_{{ region.name }}),
        .latched_state_q(violation_latched_state_q_{{ region.name }})
    );
    assign access_violation_{{ region.name }} = violation_latched_{{ region.name }};
{% endfor %}

endmodule

`default_nettype wire
