    signal decode_{{ ch.name }}_read            : std_logic;
    signal access_violation_{{ ch.name }}_sig   : std_logic;
    signal rd_{{ ch.name }}                     : std_logic_vector(31 downto 0);
{% if ch.kind == 'status' %}
    signal {{ ch.name }}_q                      : std_logic_vector({{ ch.width_w - 1 }} downto 0);
    signal latched_{{ ch.name }}                : std_logic;
{% elif ch.kind == 'command' %}
    signal {{ ch.name }}_holding_q              : std_logic_vector({{ ch.width_w - 1 }} downto 0);
    signal {{ ch.name }}_fire_reg               : std_logic;
{% elif ch.kind == 'queue' %}
    signal {{ ch.name }}_empty_sig              : std_logic;
    signal {{ ch.name }}_full_sig               : std_logic;
{% elif ch.kind == 'shared' %}
    signal {{ ch.name }}_grant_sig              : std_logic;
