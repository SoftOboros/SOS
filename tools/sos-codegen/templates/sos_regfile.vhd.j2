    decode_{{ ch.name }}_write <=
        bus_write_valid and addr_match_{{ ch.name }}
        and zone_match_{{ ch.name }} and access_type_write_ok_{{ ch.name }};
    decode_{{ ch.name }}_read <=
        bus_read_valid and addr_match_{{ ch.name }}
        and zone_match_{{ ch.name }} and access_type_read_ok_{{ ch.name }};
    access_violation_{{ ch.name }}_sig <=
        (bus_write_valid or bus_read_valid)
        and addr_match_{{ ch.name }}
        and ( (not zone_match_{{ ch.name }})
              or (bus_write_valid and (not access_type_write_ok_{{ ch.name }}))
              or (bus_read_valid  and (not access_type_read_ok_{{ ch.name }})) );
{% endfor %}

    -- -----------------------------------------------------------------
    -- Per-channel realisation blocks (§5.2).
    -- -----------------------------------------------------------------
{% for ch in view.channels %}
{% if ch.kind == 'status' %}
    -- status / hw→sw : sos_strobe_latch + level-held value register.
