    process(clk)
    begin
        if rising_edge(clk) then
            if rst = '1' then
                {{ ch.name }}_q <= RESET_VALUE_{{ ch.name|upper }}({{ ch.width_w - 1 }} downto 0);
            elsif hw_{{ ch.name }}_strobe = '1' then
                {{ ch.name }}_q <= hw_{{ ch.name }}_value;
            elsif decode_{{ ch.name }}_read = '1' and {{ "true" if ch.has_clear_on_read else "false" }} then
                {{ ch.name }}_q <= (others => '0');
            end if;
        end if;
    end process;
    rd_{{ ch.name }} <=
        std_logic_vector(resize(unsigned({{ ch.name }}_q), 32))
        and READ_MASK_{{ ch.name|upper }};
{% elif ch.kind == 'command' %}
    -- command / sw→hw : write-only holding register + REGISTERED fire strobe.
    process(clk)
    begin
        if rising_edge(clk) then
            if rst = '1' then
                {{ ch.name }}_holding_q <= RESET_VALUE_{{ ch.name|upper }}({{ ch.width_w - 1 }} downto 0);
                {{ ch.name }}_fire_reg  <= '0';
            elsif decode_{{ ch.name }}_write = '1' then
                {{ ch.name }}_holding_q <=
                    (bus_wdata({{ ch.width_w - 1 }} downto 0) and WRITE_MASK_{{ ch.name|upper }}({{ ch.width_w - 1 }} downto 0))
                    or ({{ ch.name }}_holding_q and (not WRITE_MASK_{{ ch.name|upper }}({{ ch.width_w - 1 }} downto 0)));
                {{ ch.name }}_fire_reg  <= '1';
            else
                {{ ch.name }}_fire_reg  <= '0';
            end if;
        end if;
    end process;
    hw_{{ ch.name }}_value <= {{ ch.name }}_holding_q;
    hw_{{ ch.name }}_fire  <= {{ ch.name }}_fire_reg;  -- cross-domain sync inserted upstream if declared
    rd_{{ ch.name }}       <= (others => '0');
{% elif ch.kind == 'queue' %}
    -- queue : sos_message_channel + sos_dpram_arb (per SOS-08-B). Stub
    -- placeholder wiring: HW-side pop = chart consumer, push = bus write.
    hw_{{ ch.name }}_m_tdata  <= (others => '0');
    hw_{{ ch.name }}_m_tvalid <= decode_{{ ch.name }}_write;
    hw_{{ ch.name }}_s_tready <= '1';
    {{ ch.name }}_empty_sig   <= '1';
    {{ ch.name }}_full_sig    <= '0';
    hw_{{ ch.name }}_empty    <= {{ ch.name }}_empty_sig;
    hw_{{ ch.name }}_full     <= {{ ch.name }}_full_sig;
    rd_{{ ch.name }}          <= (others => '0');
{% elif ch.kind == 'shared' %}
    -- shared : sos_dpram_arb + sos_mutex (per §5.2 / SOS-08-A).
    {{ ch.name }}_grant_sig <= '1';
    hw_{{ ch.name }}_grant  <= {{ ch.name }}_grant_sig;
    hw_{{ ch.name }}_rdata  <= (others => '0');
    rd_{{ ch.name }}        <= (others => '0');
{% endif %}
{% endfor %}

    -- -----------------------------------------------------------------
    -- Read-data mux (reserved-bit / non-matching reads return 0 per
    -- PCDN-SOS-09-E-002(a)).
    -- -----------------------------------------------------------------
    process(read_data_mux
{% for ch in view.channels %}
        , decode_{{ ch.name }}_read, rd_{{ ch.name }}
{% endfor %}
    )
        variable mux_v : std_logic_vector(31 downto 0);
    begin
        mux_v := (others => '0');
{% for ch in view.channels %}
        if decode_{{ ch.name }}_read = '1' then
            mux_v := rd_{{ ch.name }};
        end if;
{% endfor %}
        read_data_mux <= mux_v;
    end process;
    s_axi_rdata  <= read_data_mux;
    s_axi_rresp  <= "00";
    s_axi_rvalid <= bus_read_valid;
    prdata       <= read_data_mux;

    -- -----------------------------------------------------------------
    -- Access-violation aggregation per privilege_region
    -- (PCDN-SOS-09-E-003(a) — ONE sos_strobe_latch per region).
    -- -----------------------------------------------------------------
{% for region in view.privilege_regions %}
    violation_or_{{ region.name }} <= '0'
{% for member in region.member_channel_names %}
        or access_violation_{{ member }}_sig
{% endfor %}
        ;
    {{ region.latch_inst }} : sos_strobe_latch
        port map (
            clk             => clk,
            rst             => rst,
            strobe          => violation_or_{{ region.name }},
            ack             => '0',
            latched         => violation_latched_{{ region.name }},
            pending_q       => open,
            latched_state_q => open
        );
    access_violation_{{ region.name }} <= violation_latched_{{ region.name }};
{% endfor %}

end architecture rtl;
