    component sos_strobe_latch is
        port (
            clk             : in  std_logic;
            rst             : in  std_logic;
            strobe          : in  std_logic;
            ack             : in  std_logic;
            latched         : out std_logic;
            pending_q       : out std_logic;
            latched_state_q : out std_logic
