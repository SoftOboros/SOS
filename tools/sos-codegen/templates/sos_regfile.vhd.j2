        port map (
            clk             => clk,
            rst             => rst,
            strobe          => hw_{{ ch.name }}_strobe,
            ack             => {% if ch.has_clear_on_read %}decode_{{ ch.name }}_read{% else %}'0'{% endif %},
            latched         => latched_{{ ch.name }},
            pending_q       => open,
            latched_state_q => open
