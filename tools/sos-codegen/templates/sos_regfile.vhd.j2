architecture rtl of sos_regfile_{{ view.peripheral_name }} is

    -- -----------------------------------------------------------------
    -- Register byte-offset constants — INV-S-MEM-E-6 (byte-for-byte
    -- identical to SOS-09-B SVD <addressOffset>).
    -- -----------------------------------------------------------------
{% for ch in view.channels %}
    constant {{ ch.reg_offset_const }} : unsigned(31 downto 0) := to_unsigned({{ ch.offset_bytes }}, 32);
{% endfor %}

    -- -----------------------------------------------------------------
    -- Per-register write/read masks (§5.3 — synthesized from chart
    -- sos:bit_layout / kind-default).
    -- -----------------------------------------------------------------
{% for ch in view.channels %}
    constant WRITE_MASK_{{ ch.name|upper }} : std_logic_vector(31 downto 0) := {{ ch.write_mask|hex32_vhdl }};
    constant READ_MASK_{{ ch.name|upper }}  : std_logic_vector(31 downto 0) := {{ ch.read_mask|hex32_vhdl }};
    constant RESET_VALUE_{{ ch.name|upper }} : std_logic_vector(31 downto 0) := {{ ch.reset_value|hex32_vhdl }};
{% endfor %}

    signal bus_addr        : std_logic_vector(31 downto 0);
    signal bus_wdata       : std_logic_vector(31 downto 0);
    signal bus_write_valid : std_logic;
    signal bus_read_valid  : std_logic;
    signal bus_privilege   : std_logic;
    signal read_data_mux   : std_logic_vector(31 downto 0);

{% for ch in view.channels %}
