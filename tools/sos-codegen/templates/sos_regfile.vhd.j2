    bus_wdata       <= pwdata when BUS_TYPE = "apb" else s_axi_wdata;
    bus_write_valid <= (psel and penable and pwrite)
                       when BUS_TYPE = "apb"
                       else (s_axi_awvalid and s_axi_wvalid);
    bus_read_valid  <= (psel and penable and (not pwrite))
                       when BUS_TYPE = "apb"
                       else s_axi_arvalid;
    bus_privilege   <= (not pprot(0)) when BUS_TYPE = "apb"
                       else (not s_axi_awprot(0));

    s_axi_awready <= '1' when BUS_TYPE = "axi4lite" else '0';
    s_axi_wready  <= '1' when BUS_TYPE = "axi4lite" else '0';
    s_axi_arready <= '1' when BUS_TYPE = "axi4lite" else '0';
    s_axi_bvalid  <= '0';
    s_axi_bresp   <= "00";
    pready        <= '1' when BUS_TYPE = "apb" else '0';
    pslverr       <= '0';

    -- -----------------------------------------------------------------
    -- Per-channel decode lines (§5.2 — combinational).
    -- -----------------------------------------------------------------
{% for ch in view.channels %}
    zone_match_{{ ch.name }} <= {{ "'1'" if ch.zone == 'unprivileged' else "bus_privilege" }};
    access_type_write_ok_{{ ch.name }} <= {{ "'1'" if ch.kind in ('command', 'queue', 'shared') else "'0'" }};
    access_type_read_ok_{{ ch.name }}  <= {{ "'1'" if ch.kind in ('status', 'queue', 'shared') else "'0'" }};
